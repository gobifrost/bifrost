{
  "description": "Phase 1 baseline: production topology (1 API, API-launched worker Jobs, no scheduler), production limits and allocator env, production-count workflows, eight execution classes, two passes.",
  "classes": [
    "wf-noop",
    "wf-sdk",
    "wf-wait",
    "wf-cpu",
    "wf-large",
    "agent-chat",
    "agent-tools",
    "agent-codemode",
    "chat-first",
    "chat-followup"
  ],
  "sequential": 10,
  "burst": 10,
  "burst_rounds": 3,
  "timeout_s": 300,
  "settle_s": 20,
  "idle_s": 120,
  "idle_db_s": 60,
  "seed": {
