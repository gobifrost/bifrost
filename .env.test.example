# Bifrost Test Environment Configuration
#
# Copy this file to .env.test for local test configuration.
# These values override docker-compose.test.yml environment variables.
#
# This file is intentionally gitignored because it contains live credentials.
# Linked Git worktrees automatically fall back to the primary checkout's
# .env.test when they do not have their own copy.
# Usage:
#   cp .env.test.example .env.test
#   # Edit .env.test with your values
#   ./test.sh e2e
#
# Or pass directly:
#   GITHUB_TEST_PAT=ghp_xxx ./test.sh tests/e2e/api/test_github.py -v

# LLM provider E2E tests. Configure the providers you want to exercise.
# OPENAPI_API_TEST_KEY is the established variable name despite referring to
# OpenAI; keep it for compatibility with the test fixtures.
ANTHROPIC_API_TEST_KEY=
OPENAPI_API_TEST_KEY=

# Optional OpenAI-compatible provider.
GENERIC_AI_TEST_KEY=
GENERIC_AI_BASE_URL=

# Knowledge and embedding E2E tests (OpenAI-compatible embeddings key).
EMBEDDINGS_AI_TEST_KEY=

# GitHub E2E tests.
# These tests require a GitHub Personal Access Token (PAT) with repo access.
# Tests will skip gracefully if not configured.
#
# 1. Create repository: jackmusick/e2e-test-workspace (or your own)
# 2. Create a fine-grained PAT with:
#    - Repository access: Only the test repository
#    - Permissions: Contents (Read and write), Metadata (Read)
# 3. Set the values below

# GitHub Personal Access Token (fine-grained recommended).
GITHUB_TEST_PAT=

# Test repository (owner/repo format)
# Default: jackmusick/e2e-test-workspace
GITHUB_TEST_REPO=jackmusick/e2e-test-workspace
