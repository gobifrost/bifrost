# Bifrost Client - Playwright E2E Test Runner
# Runs Playwright tests inside a container against the client service
#
# Usage (via test.sh):
#   ./test.sh client e2e      # Run Playwright E2E tests in the client container

# Keep the browser/system dependencies from Playwright's image, but use the
# same Node runtime required by package.json and used by CI/client builds.
FROM node:26-slim@sha256:c0753125a3789977aefe869cbebccf70e3cfd7ea84ca48547458f02e4f1d7146 AS node-runtime

# mcr.microsoft.com/playwright:v1.56.0-jammy
FROM mcr.microsoft.com/playwright:v1.63.0-jammy@sha256:167d0506cfbe3c294fb214b2d11737326eeee028aa611fa1ba538e5057675847

COPY --from=node-runtime /usr/local/ /usr/local/

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Cache the exact Monaco CDN assets used by the app editor tests. The product
# runtime loads Monaco from jsDelivr, but E2E runs should not depend on live CDN
# timing. Keep this version aligned with client/src/lib/monaco-setup.ts.
RUN set -eux; \
    tmp_dir="$(mktemp -d)"; \
    npm pack monaco-editor@0.54.0 --pack-destination "$tmp_dir"; \
    mkdir -p /opt/monaco-cdn/monaco-editor-0.54.0; \
    tar -xzf "$tmp_dir"/monaco-editor-0.54.0.tgz -C /opt/monaco-cdn/monaco-editor-0.54.0 --strip-components=1; \
    rm -rf "$tmp_dir"

# Install only Chromium browser (faster than installing all browsers)
RUN npx playwright install chromium

# Test files, config, and fixtures come from volume mounts
# This allows live editing without rebuilding the image

# Default command runs all tests with list and HTML reporters
CMD ["npx", "playwright", "test", "--reporter=list,html"]
