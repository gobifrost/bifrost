# Keep test sources/auth states excluded from production build contexts.
!e2e/
e2e/*
!e2e/fixtures/
e2e/fixtures/*
!e2e/fixtures/sdk-header/
e2e/fixtures/sdk-header/*
!e2e/fixtures/sdk-header/package*.json
playwright.config.ts
Dockerfile.playwright

